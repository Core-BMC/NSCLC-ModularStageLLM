# Azure OpenAI API Key and Endpoint
AZURE_OPENAI_API_KEY=azure_apikey
AZURE_OPENAI_ENDPOINT=https://user-endpoint.openai.azure.com/
AZURE_OPENAI_API_BASE=https://user-endpoint.openai.azure.com/
OPENAI_API_BASE=https://user-endpoint.openai.azure.com/
AZURE_OPENAI_API_VERSION=model-deployed-version
OPENAI_API_VERSION=model-deployed-version
AZURE_DEPLOYMENT_NAME=user-azureopenai-gpt-model-name_e.g._(gpt-4o)

# OpenAI API Settings (for direct OpenAI API)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=user-openai-model-name_e.g._(gpt-4o)

# The same two keys above are used by every module, including the WHO
# histology classifier (src/histology/workflow.py).

# Local API Settings (for local LLM servers such as Ollama)
# These are optional: they override model_settings.local in
# config/tnm_config.yaml when set.
LOCAL_API_BASE_URL=http://your-local-llm-host:11434
LOCAL_API_KEY=your_local_bearer_token
LOCAL_API_MODEL_NAME=llama3.3:70b
LOCAL_API_TEMPERATURE=0.5
